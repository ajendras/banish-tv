{
    "name": "banish-tv/banish-tv",
    "description": "Removes bloatware and telemetry from any Android/Google TV over Wi-Fi, installs a minimal Apple-TV-style launcher, and provides a secure local web dashboard with pluggable profiles.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "symfony/console": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "BanishTV\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BanishTV\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public",
        "test": "vendor/bin/phpunit"
    },
    "bin": [
        "bin/banish"
    ]
}
